# Environment Configuration for Integration Tests
# Copy this file to .env.integration and update with your values

# Production Database Connection
# IMPORTANT: These tests run against PRODUCTION data
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database_name

# API Endpoints
# These should point to your running API server
ADMIN_API_URL=http://localhost:3000/api/v1
POS_API_URL=http://localhost:3000/api/v1/salesman/pos

# Test Behavior
# Set to true to automatically fix detected inconsistencies
AUTO_RESOLVE_INCONSISTENCIES=false

# Set to true to preview fixes without applying them
DRY_RUN=true

# Enable detailed test logging
VERBOSE_TESTS=true

# Log level: info, warn, error
LOG_LEVEL=info

# JWT Configuration (for authentication in tests)
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# Test User Credentials (optional, for authenticated tests)
TEST_ADMIN_USERNAME=admin
TEST_ADMIN_PASSWORD=admin_password
TEST_SALESMAN_USERNAME=salesman
TEST_SALESMAN_PASSWORD=salesman_password
